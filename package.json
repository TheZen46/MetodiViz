{
  "name": "metodiviz",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Zen",
  "description": "Visualizzatore grafico 3D, 2D e complesso per studiare le dimostrazioni di Metodi Matematici",
  "keywords": [
    "mathematics",
    "latex",
    "threejs",
    "calculus",
    "fourier",
    "complex-analysis",
    "mathlive",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-mathlive-assets.mjs"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.468.0",
    "mathlive": "^0.103.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
